# Bitvavo API keys — NIET nodig voor paper trading (public data is open).
# Pas invullen als ENV=live: bitvavo.com/account/api → Create new key (perms: View + Trade, NIET Withdraw)
BITVAVO_API_KEY=
BITVAVO_SECRET=

# Supabase — maak project aan op supabase.com, kopieer URL + anon key
SUPABASE_URL=
SUPABASE_KEY=

# 'paper' = gesimuleerde orders met live Bitvavo data (geen keys nodig) — START HIER
# 'live'  = echte trades met echt geld (pas na maanden winstgevende paper runs)
ENV=paper

# Exchange voor marktdata + (later) order execution
EXCHANGE=bitvavo
